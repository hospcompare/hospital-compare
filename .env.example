# PostgreSQL (docker-compose postgres service, or local equivalent)
DATABASE_URL="postgresql://hospital:hospital@localhost:5432/hospital_compare?schema=public"

# Required to POST /api/ingest/candidates (Grok / pipeline agents)
INGEST_API_KEY="local-dev-ingest-key"

# Public origin used in examples; the app does not require it at runtime
NEXT_PUBLIC_APP_URL="http://localhost:43180"
