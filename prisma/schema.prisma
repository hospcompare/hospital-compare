// Hospital Compare production schema.
// Agents never write these tables as live UI content.
// Pipeline: sources → agent candidates → staging (status=staging or staging_* tables)
//          → validation → approved production rows → Website/API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  staging
  approved
  rejected
}

enum ModerationStatus {
  pending
  approved
  flagged
  rejected
}

enum EmploymentType {
  travel
  staff
  per_diem
  contract
  unknown
}

enum Sentiment {
  positive
  mixed
  negative
  unknown
}

enum CandidateType {
  hospital
  fact
  salary
  col_index
}

enum WorkplaceMetricValueType {
  number
  boolean
  text
  option
}

/// Production hospital directory. Primary identifier is CMS CCN (string).
/// Name variants are not keys — always join/dedupe on `ccn`.
model Hospital {
  ccn            String   @id
  name           String
  address        String
  city           String
  state          String
  zip            String
  county         String?
  healthSystem   String?  @map("health_system")
  hospitalType   String?  @map("hospital_type")
  traumaLevel    String?  @map("trauma_level")
  beds           Int?
  teachingStatus String?  @map("teaching_status")
  ownership      String?
  emr            String?
  website        String?
  magnetStatus   String?  @map("magnet_status")
  isSeed         Boolean  @default(false) @map("is_seed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  facts             HospitalFact[]
  salaries          Salary[]
  reviews           Review[]
  workplaceReports  WorkplaceReport[]
  qualitySnapshots  CmsQualitySnapshot[]
  countyResolutions HospitalCountyResolution[]

  @@index([name])
  @@index([state, city])
  @@index([zip])
  @@map("hospitals")
}

/// Sourced field values with provenance. UI reads approved rows only.
model HospitalFact {
  id            String       @id @default(cuid())
  hospitalCcn   String       @map("hospital_ccn")
  fieldName     String       @map("field_name")
  value         String
  source        String
  sourceUrl     String?      @map("source_url")
  effectiveDate DateTime?    @map("effective_date") @db.Date
  confidence    Float?
  status        RecordStatus @default(staging)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)

  @@index([hospitalCcn, fieldName, status])
  @@map("hospital_facts")
}

model Salary {
  id            String       @id @default(cuid())
  hospitalCcn   String       @map("hospital_ccn")
  role          String
  professionId  String?      @map("profession_id")
  specialtyId   String?      @map("specialty_id")
  hourlyMin     Decimal      @map("hourly_min") @db.Decimal(8, 2)
  hourlyMax     Decimal      @map("hourly_max") @db.Decimal(8, 2)
  annual        Decimal?     @db.Decimal(12, 2)
  source        String
  sourceUrl     String?      @map("source_url")
  effectiveDate DateTime?    @map("effective_date") @db.Date
  confidence    Float?
  status        RecordStatus @default(staging)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  hospital   Hospital    @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)
  profession Profession? @relation(fields: [professionId], references: [id], onDelete: SetNull)
  specialty  Specialty?  @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  @@index([hospitalCcn, role, status])
  @@index([hospitalCcn, professionId, status])
  @@index([hospitalCcn, professionId, specialtyId, status])
  @@index([professionId])
  @@index([specialtyId])
  @@map("salaries")
}

/// Cost-of-living index keyed by ZIP or metro code. Sample dataset only in this milestone.
model ColIndex {
  id          String   @id @default(cuid())
  locationKey String   @map("location_key")
  keyType     String   @map("key_type")
  indexValue  Decimal  @map("index_value") @db.Decimal(8, 2)
  datasetName String   @map("dataset_name")
  asOfDate    DateTime @map("as_of_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([locationKey, datasetName, asOfDate])
  @@index([locationKey])
  @@map("col_indexes")
}

/// Peer reviews. `body` is the original submission and must remain immutable.
model Review {
  id               String           @id @default(cuid())
  hospitalCcn      String           @map("hospital_ccn")
  /// Original review text. Do not update after insert.
  body             String
  employmentType   EmploymentType   @map("employment_type")
  unit             String?
  overallScore     Int?             @map("overall_score")
  staffingScore    Int?             @map("staffing_score")
  managementScore  Int?             @map("management_score")
  payScore         Int?             @map("pay_score")
  wlbScore         Int?             @map("wlb_score")
  sentiment        Sentiment?
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  fraudRiskScore   Float?           @map("fraud_risk_score")
  createdAt        DateTime         @default(now()) @map("created_at")

  hospital Hospital     @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)
  flags    ReviewFlag[]

  @@index([hospitalCcn, moderationStatus])
  @@map("reviews")
}

model ReviewFlag {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  reason    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_flags")
}

/// Raw agent payloads before validation. Never served to the public UI.
model StagingCandidate {
  id            String        @id @default(cuid())
  sourceAgent   String        @map("source_agent")
  candidateType CandidateType @map("candidate_type")
  payload       Json
  status        RecordStatus  @default(staging)
  errorMessage  String?       @map("error_message")
  createdAt     DateTime      @default(now()) @map("created_at")
  processedAt   DateTime?     @map("processed_at")

  @@index([status, createdAt])
  @@map("staging_candidates")
}

/// New hospital identity proposed by agents. Promoted to `hospitals` only after validation.
model StagingHospital {
  id        String       @id @default(cuid())
  ccn       String
  payload   Json
  source    String
  sourceUrl String?      @map("source_url")
  status    RecordStatus @default(staging)
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([ccn, status])
  @@map("staging_hospitals")
}

model CmsQualitySnapshot {
  id          String @id @default(cuid())
  hospitalCcn String @map("hospital_ccn")

  overallRating         Int?    @map("overall_rating")
  overallRatingFootnote String? @map("overall_rating_footnote")

  mortalityMeasureCount Int? @map("mortality_measure_count")
  mortalityBetter       Int? @map("mortality_better")
  mortalitySame         Int? @map("mortality_same")
  mortalityWorse        Int? @map("mortality_worse")

  safetyMeasureCount Int? @map("safety_measure_count")
  safetyBetter       Int? @map("safety_better")
  safetySame         Int? @map("safety_same")
  safetyWorse        Int? @map("safety_worse")

  readmissionMeasureCount Int? @map("readmission_measure_count")
  readmissionBetter       Int? @map("readmission_better")
  readmissionSame         Int? @map("readmission_same")
  readmissionWorse        Int? @map("readmission_worse")

  patientExperienceMeasureCount Int? @map("patient_experience_measure_count")

  sourceDataset String   @map("source_dataset")
  sourceUrl     String?  @map("source_url")
  releaseDate   DateTime @map("release_date") @db.Date
  importedAt    DateTime @default(now()) @map("imported_at")

  hospital Hospital @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)

  @@unique([hospitalCcn, releaseDate])
  @@index([hospitalCcn])
  @@index([overallRating])
  @@map("cms_quality_snapshots")
}

/// Healthcare profession used to scope workplace data.
/// Stored as records rather than an enum so professions can be added without schema changes.
model Profession {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  abbreviation String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  specialties        Specialty[]
  workplaceReports   WorkplaceReport[]
  salaries           Salary[]
  localPayBenchmarks LocalPayBenchmark[]

  @@index([active, sortOrder])
  @@map("professions")
}

/// Optional profession-specific specialty or practice area.
/// A profession may have many specialties, while workplace data may also exist
/// at the broader profession level without selecting a specialty.
model Specialty {
  id           String   @id @default(cuid())
  professionId String   @map("profession_id")
  slug         String
  name         String
  abbreviation String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profession       Profession        @relation(fields: [professionId], references: [id], onDelete: Cascade)
  workplaceReports WorkplaceReport[]
  salaries         Salary[]

  @@unique([professionId, slug])
  @@index([professionId, active, sortOrder])
  @@map("specialties")
}

/// Profession-level wage benchmark for one geographic labor-market area and source release.
/// Validated source/reference data, like CmsQualitySnapshot. Not hospital-specific,
/// not specialty-specific, and not worker-reported or employer-posted pay.
/// RecordStatus is omitted: this is not agent-staged or user-moderated content.
/// Releases are preserved as separate rows. effectiveDate is metadata and is not
/// part of the unique identity.
model LocalPayBenchmark {
  id           String @id @default(cuid())
  professionId String @map("profession_id")

  /// Area code from the source geography system. Not a hospital identifier.
  geographicAreaCode String @map("geographic_area_code")
  geographicAreaName String @map("geographic_area_name")
  /// Source geography type, stored as published (for example state or metropolitan area).
  geographicLevel    String @map("geographic_level")

  hourlyMean   Decimal? @map("hourly_mean") @db.Decimal(8, 2)
  hourlyMedian Decimal? @map("hourly_median") @db.Decimal(8, 2)
  annualMean   Decimal? @map("annual_mean") @db.Decimal(12, 2)
  annualMedian Decimal? @map("annual_median") @db.Decimal(12, 2)

  source        String
  /// Dataset or release identifier. Required so each release has a stable identity.
  sourceDataset String    @map("source_dataset")
  sourceUrl     String?   @map("source_url")
  /// Reference period for the wage statistics. Metadata only; not part of uniqueness.
  effectiveDate DateTime? @map("effective_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profession Profession @relation(fields: [professionId], references: [id])

  @@unique([professionId, geographicAreaCode, geographicLevel, source, sourceDataset])
  @@index([source, sourceDataset])
  @@map("local_pay_benchmarks")
}

/// Resolved county-equivalent identity for one hospital and one geography vintage.
/// This is the stable join key into OewsAreaCounty. It is not a CBSA code and not
/// an OEWS area code. RecordStatus is omitted: rows are deterministic reference
/// geography, not agent-staged or user-moderated content.
/// source and sourceDataset identify the county authority and vintage
/// (for example Census Bureau / all-geocodes-v2024), not an OEWS wage release.
/// A new vintage is a new row. One hospital has one resolution per vintage.
model HospitalCountyResolution {
  id               String   @id @default(cuid())
  hospitalCcn      String   @map("hospital_ccn")
  countyFips       String   @map("county_fips")
  countyName       String   @map("county_name")
  stateFips        String   @map("state_fips")
  /// Postal abbreviation, for example WA.
  stateCode        String   @map("state_code") @db.Char(2)
  source           String
  sourceDataset    String   @map("source_dataset")
  resolutionMethod String   @map("resolution_method")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)

  @@unique([hospitalCcn, source, sourceDataset])
  @@index([countyFips])
  @@map("hospital_county_resolutions")
}

/// County equivalent to one OEWS metropolitan or nonmetropolitan area for one release.
/// The May 2025 area-definition workbook maps each county FIPS to exactly one area,
/// so countyFips + source + sourceDataset is the release identity.
/// Join to LocalPayBenchmark on geographicAreaCode, geographicLevel, source, and
/// sourceDataset. There is no foreign key: benchmark rows are profession wages.
/// RecordStatus is omitted. Later OEWS releases are additional rows, not updates.
model OewsAreaCounty {
  id                 String   @id @default(cuid())
  countyFips         String   @map("county_fips")
  geographicAreaCode String   @map("geographic_area_code")
  geographicAreaName String   @map("geographic_area_name")
  /// Published geography type, for example Metropolitan Statistical Area.
  geographicLevel    String   @map("geographic_level")
  source             String
  sourceDataset      String   @map("source_dataset")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([countyFips, source, sourceDataset])
  @@index([countyFips, sourceDataset])
  @@index([geographicAreaCode, geographicLevel, sourceDataset])
  @@map("oews_area_counties")
}

/// Structured healthcare-worker observations about a workplace.
/// Reports are scoped to a profession and may optionally be scoped to a specialty.
/// Subjective ratings and written commentary remain in Review.
model WorkplaceReport {
  id               String           @id @default(cuid())
  hospitalCcn      String           @map("hospital_ccn")
  professionId     String           @map("profession_id")
  specialtyId      String?          @map("specialty_id")
  employmentType   EmploymentType   @map("employment_type")
  experienceDate   DateTime?        @map("experience_date") @db.Date
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  fraudRiskScore   Float?           @map("fraud_risk_score")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  hospital     Hospital               @relation(fields: [hospitalCcn], references: [ccn], onDelete: Cascade)
  profession   Profession             @relation(fields: [professionId], references: [id])
  specialty    Specialty?             @relation(fields: [specialtyId], references: [id])
  observations WorkplaceObservation[]

  @@index([hospitalCcn, moderationStatus])
  @@index([hospitalCcn, professionId, moderationStatus])
  @@index([professionId, specialtyId])
  @@index([experienceDate])
  @@map("workplace_reports")
}

/// Catalog of structured workplace measurements.
/// New metrics can be introduced as records without changing the database schema.
model WorkplaceMetric {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  label       String
  description String?
  category    String
  valueType   WorkplaceMetricValueType @map("value_type")
  unit        String?
  active      Boolean                  @default(true)
  sortOrder   Int                      @default(0) @map("sort_order")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  observations WorkplaceObservation[]

  @@index([category, active, sortOrder])
  @@map("workplace_metrics")
}

/// One structured workplace measurement reported within a WorkplaceReport.
/// Application validation ensures the populated value matches the metric's valueType.
model WorkplaceObservation {
  id           String   @id @default(cuid())
  reportId     String   @map("report_id")
  metricId     String   @map("metric_id")
  numericValue Decimal? @map("numeric_value") @db.Decimal(12, 3)
  booleanValue Boolean? @map("boolean_value")
  textValue    String?  @map("text_value")
  optionValue  String?  @map("option_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  report WorkplaceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metric WorkplaceMetric @relation(fields: [metricId], references: [id])

  @@unique([reportId, metricId])
  @@index([metricId])
  @@map("workplace_observations")
}
